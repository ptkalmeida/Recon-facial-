# ==========================================
# Face Recognition Pro 2.0 - Environment Variables
# ==========================================
# Copie este arquivo para .env e configure os valores
# NUNCA commit o arquivo .env com valores reais!

# ==========================================
# SECURITY - CRITICAL: set unique values before running in production.
# ==========================================
# JWT Secret - Use a strong random string (min 32 chars)
# Generate: openssl rand -base64 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Encryption key for face embeddings (min 16 chars)
# Generate: openssl rand -base64 16
# Criptografa os embeddings faciais em repouso (Fernet, chave derivada por PBKDF2).
# Se ficar vazia, os embeddings sao gravados em texto claro (com aviso no startup).
# IMPORTANTE: faca backup desta chave JUNTO com data/embedding_salt.key - sem os
# dois, os embeddings ja gravados nao podem ser recuperados.
EMBEDDING_ENCRYPTION_KEY=your-encryption-key-16+

# ==========================================
# SERVER CONFIGURATION
# ==========================================
HOST=0.0.0.0
PORT=8001
RELOAD=false
ENVIRONMENT=production

# ==========================================
# FACE RECOGNITION
# ==========================================
FACE_MODEL=Facenet512
FACE_DETECTOR=retinaface
FACE_DISTANCE_METRIC=cosine
FACE_THRESHOLD=0.4
FACE_ENFORCE_DETECTION=true

# ==========================================
# ANTI-SPOOFING
# ==========================================
ANTI_SPOOFING_ENABLED=true
LIVENESS_CHECK=true

# ==========================================
# DATABASE
# ==========================================
DATABASE_PATH=data/face_recognition.db

# ==========================================
# CORS - Restrict in production!
# ==========================================
# Comma-separated list of allowed origins
# Example: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_MAX_ATTEMPTS=5
AUTH_BLOCK_DURATION=900

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=logs/face_recognition.log

# ==========================================
# EMAIL ALERTS (unknown face detected)
# ==========================================
# Disabled by default - requires a real SMTP account to work
ALERTS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=alerts@example.com
ALERT_EMAIL_TO=security-team@example.com
# Minimum seconds between repeated alerts for the same camera
ALERT_COOLDOWN_SECONDS=600

# ==========================================
# SERVER-SIDE CAMERA CAPTURE (optional)
# ==========================================
# Disabled by default - the browser webcam capture in the dashboard works either way.
# Enable to run continuous recognition against a local webcam or an RTSP/IP camera
# from the server itself, without needing the dashboard tab open.
SERVER_CAMERA_ENABLED=false
# Empty = disabled. A digit (e.g. "0") = local webcam index.
# Otherwise treated as an RTSP URL or a video file path.
SERVER_CAMERA_SOURCE=
SERVER_CAMERA_ID=server-cam
SERVER_CAMERA_INTERVAL_SECONDS=1.0
